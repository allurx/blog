{
    "name": "blog",
    "author": "allurx",
    "license": "Apache-2.0",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "vite --host 0.0.0.0",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint . --max-warnings 0",
        "type-check": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
        "check": "npm run format:check && npm run lint && npm run type-check",
        "verify": "npm run build",
        "build": "npm run check && node scripts/build.ts",
        "preview": "wrangler dev",
        "deploy": "wrangler deploy"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "24.19.1",
        "eslint": "10.12.0",
        "highlight.js": "11.12.0",
        "katex": "0.18.9",
        "marked": "18.0.14",
        "prettier": "3.9.9",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.0",
        "vite": "8.3.1",
        "wrangler": "4.145.0",
        "yaml": "2.9.1"
    },
    "prettier": {
        "tabWidth": 4,
        "printWidth": 120,
        "semi": true,
        "singleQuote": false,
        "endOfLine": "lf",
        "embeddedLanguageFormatting": "auto",
        "trailingComma": "es5"
    }
}
