{
    "name": "blog",
    "author": "allurx",
    "license": "Apache-2.0",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": "24.21.0"
    },
    "scripts": {
        "dev": "vite --open --host 0.0.0.0",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint . --max-warnings 0",
        "type-check": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
        "check": "npm run format:check && npm run lint && npm run type-check",
        "verify": "npm run build",
        "build": "npm run check && node scripts/build.ts",
        "preview": "wrangler dev",
        "deploy": "wrangler deploy"
    },
    "devDependencies": {
        "@allurx/web-foundation": "git+https://github.com/allurx/web-foundation.git#v1.0.0",
        "highlight.js": "11.12.0",
        "katex": "0.18.9",
        "marked": "18.0.14",
        "yaml": "2.9.1"
    },
    "prettier": "@allurx/web-foundation/prettier"
}
