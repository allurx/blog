{
  "name": "allurx-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.ts",
    "preview": "wrangler dev --port 4173",
    "type-check": "tsc --noEmit",
    "test": "node --test scripts/*.test.ts",
    "verify": "npm run type-check && npm test && npm run build",
    "deploy": "npm run verify && wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "katex": "0.18.9",
    "marked": "18.0.14",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "wrangler": "4.145.0",
    "yaml": "2.9.1"
  }
}
