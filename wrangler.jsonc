{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blog",
  "account_id": "b3dbe3e093f330ca0e3b689db4b47e6e",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
